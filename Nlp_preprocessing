from itertools import product

def generate_variants(word):
    variants = set()

    # basic forms
    variants.add(word)
    variants.add(word.lower())
    variants.add(word.upper())
    variants.add(word.capitalize())

    # pluralization (simple)
    if not word.endswith('s'):
        variants.add(word + 's')

    # common suffixes
    suffixes = ['ing', 'ed']
    for s in suffixes:
        variants.add(word + s)

    return list(variants)


keywords = ['tamper', 'vandal', 'disconnect']

variant_dict = {k: generate_variants(k) for k in keywords}

print(variant_dict)


