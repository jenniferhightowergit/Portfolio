from collections import Counter
import re

def find_variants(comments, keyword):
    pattern = re.compile(rf'\b\w*{keyword}\w*\b', re.IGNORECASE)
    matches = []

    for c in comments:
        matches.extend(pattern.findall(c))

    return Counter(matches)

