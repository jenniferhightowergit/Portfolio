from pathlib import Path
import pandas as pd
import re

# --------------------------------------------------
# 1. Folder where daily files live
# --------------------------------------------------
folder = Path(r"\\your\shared\drive\folder")

# Change pattern as needed
# Examples:
# "*.xlsx"
# "NonCom*.xlsx"
# "*non*com*.xlsx"
file_pattern = "*.xlsx"

files = list(folder.glob(file_pattern))

if not files:
    raise FileNotFoundError(f"No files found in {folder} matching {file_pattern}")

# --------------------------------------------------
# 2. Function to extract file date from filename
# --------------------------------------------------
def extract_file_date(file_path):
    """
    Tries to find a date in the filename.
    Supports formats like:
    20260423
    2026-04-23
    04-23-2026
    04_23_2026
    """

    filename = file_path.stem

    # YYYYMMDD or YYYY-MM-DD or YYYY_MM_DD
    match = re.search(r"(\d{4})[-_]?(\d{2})[-_]?(\d{2})", filename)
    if match:
        year, month, day = match.groups()
        return pd.to_datetime(f"{year}-{month}-{day}").date()

    # MMDDYYYY or MM-DD-YYYY or MM_DD_YYYY
    match = re.search(r"(\d{2})[-_]?(\d{2})[-_]?(\d{4})", filename)
    if match:
        month, day, year = match.groups()
        return pd.to_datetime(f"{year}-{month}-{day}").date()

    # Fallback: use file modified date
    return pd.to_datetime(file_path.stat().st_mtime, unit="s").date()


# --------------------------------------------------
# 3. Read every file and append file_date
# --------------------------------------------------
all_dfs = []

for file in files:
    print(f"Reading: {file.name}")

    file_date = extract_file_date(file)

    df = pd.read_excel(file, engine="openpyxl")

    df["file_date"] = file_date
    df["source_file"] = file.name

    all_dfs.append(df)

# --------------------------------------------------
# 4. Combine into one dataframe
# --------------------------------------------------
combined_df = pd.concat(all_dfs, ignore_index=True)

# Optional: convert file_date to datetime for Tableau
combined_df["file_date"] = pd.to_datetime(combined_df["file_date"])

# --------------------------------------------------
# 5. Export for Tableau
# --------------------------------------------------
output_path = folder / "combined_daily_non_com_snapshots.xlsx"

combined_df.to_excel(output_path, index=False)

print(f"Done. Exported to: {output_path}")
print(f"Rows: {len(combined_df):,}")
print(f"Files processed: {len(files):,}")
