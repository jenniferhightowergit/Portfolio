meyer level summary

meter_df = event_table.groupby('meter_id').agg(
    first_deploy_date = ('event_date', lambda x: x[event_table.loc[x.index, 'event_type']=='deploy'].min()),
    first_ncm_date = ('event_date', lambda x: x[event_table.loc[x.index, 'event_type']=='ncm'].min()),
    first_change_date = ('event_date', lambda x: x[event_table.loc[x.index, 'event_type']=='meter_change'].min()),
    total_changes = ('event_type', lambda x: (x == 'meter_change').sum()),
    total_ncms = ('event_type', lambda x: (x == 'ncm').sum())
).reset_index()


meter_df['days_to_first_failure'] = (
    meter_df['first_ncm_date'] - meter_df['first_deploy_date']
).dt.days

meter_df['days_to_first_change'] = (
    meter_df['first_change_date'] - meter_df['first_deploy_date']
).dt.days



