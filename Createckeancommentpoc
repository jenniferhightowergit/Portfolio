3. Handle abbreviations separately

abbrev_dict = {
    "mtr": "meter",
    "xfmr": "transformer",
    "fw": "firmware",
    "comms": "communication",
    "vltg": "voltage"
}

words = text.split()

words = [abbrev_dict.get(w, w) for w in words]


