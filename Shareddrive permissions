from pathlib import Path
import os
import traceback

def test_folder_permissions(path_str):
    path = Path(path_str)

    result = {
        "path": str(path),
        "is_dir": None,
        "os_read": None,
        "os_write": None,
        "can_list": False,
        "can_create_file": False,
        "can_delete_file": False,
        "notes": []
    }

    # Try to determine if it's a directory, but don't trust exists() alone
    try:
        result["is_dir"] = path.is_dir()
    except Exception as e:
        result["notes"].append(f"is_dir check failed: {e}")

    # os.access can still be useful as a hint
    try:
        result["os_read"] = os.access(path, os.R_OK)
        result["os_write"] = os.access(path, os.W_OK)
    except Exception as e:
        result["notes"].append(f"os.access failed: {e}")

    # Real test: can we list contents?
    try:
        items = list(path.iterdir())
        result["can_list"] = True
        result["notes"].append(f"Listed folder successfully. Item count: {len(items)}")
    except Exception as e:
        result["notes"].append(f"Could not list folder: {type(e).__name__}: {e}")

    # Real test: can we create/delete a temp file?
    test_file = path / "__permission_test__.tmp"
    try:
        with open(test_file, "w") as f:
            f.write("test")
        result["can_create_file"] = True
        result["notes"].append("Created temp file successfully.")
    except Exception as e:
        result["notes"].append(f"Could not create temp file: {type(e).__name__}: {e}")

    if result["can_create_file"]:
        try:
            test_file.unlink()
            result["can_delete_file"] = True
            result["notes"].append("Deleted temp file successfully.")
        except Exception as e:
            result["notes"].append(f"Could not delete temp file: {type(e).__name__}: {e}")

    return result


folders_to_test = [
    r"\\server\share\folder1",
    r"\\server\share\folder2",
    r"\\server\share\folder3"
]

for folder in folders_to_test:
    print("\n" + "=" * 90)
    result = test_folder_permissions(folder)
    for k, v in result.items():
        if k != "notes":
            print(f"{k}: {v}")
    print("notes:")
    for note in result["notes"]:
        print(" -", note)





from pathlib import Path
import os
import pandas as pd

def test_file_permissions(file_path):
    path = Path(file_path)

    result = {
        "path": str(path),
        "exists": path.exists(),
        "is_file": path.is_file(),
        "extension": path.suffix.lower(),
        "os_read": None,
        "os_write": None,
        "can_open_read": False,
        "can_open_append": False,
        "can_rename": False,
        "can_delete": False,
        "parent_exists": path.parent.exists(),
        "notes": ""
    }

    if not path.exists():
        result["notes"] = "Path does not exist or is not reachable"
        return result

    if not path.is_file():
        result["notes"] = "Path exists but is not a file"
        return result

    result["os_read"] = os.access(path, os.R_OK)
    result["os_write"] = os.access(path, os.W_OK)

    # Test read
    try:
        with open(path, "rb") as f:
            f.read(100)
        result["can_open_read"] = True
    except Exception as e:
        result["notes"] += f"Read failed: {e} | "

    # Test append/write
    try:
        with open(path, "ab") as f:
            pass
        result["can_open_append"] = True
    except Exception as e:
        result["notes"] += f"Append failed: {e} | "

    # Test rename (good indicator of write-level control on file)
    temp_name = path.with_name(path.stem + "__permtest__" + path.suffix)
    try:
        os.rename(path, temp_name)
        os.rename(temp_name, path)
        result["can_rename"] = True
    except Exception as e:
        result["notes"] += f"Rename failed: {e} | "

    # Test delete is dangerous on real files, so we DO NOT do it here
    # unless you explicitly want a destructive test.
    result["can_delete"] = None

    if result["notes"].endswith(" | "):
        result["notes"] = result["notes"][:-3]

    return result


# Example: list the exact files you want to test
files_to_test = [
    r"\\server\share\folder\a.xlsx",
    r"\\server\share\folder\b.cab",
    r"\\server\share\folder\subfolder\c.xlsx"
]

results = [test_file_permissions(f) for f in files_to_test]

df = pd.DataFrame(results)
